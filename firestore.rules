rules_version = '2';

// Правила безопасности Тамыра (M1).
// Главная идея: пользователь видит и меняет ТОЛЬКО грядки, где ownerId == его uid.
// Симулятор работает через Admin SDK — он эти правила не проверяет.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function ownsGreenhouse(ghId) {
      return signedIn() &&
        get(/databases/$(database)/documents/greenhouses/$(ghId)).data.ownerId == request.auth.uid;
    }

    // Профиль пользователя — только сам пользователь.
    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    // Теплица: читать и менять может только владелец.
    // Поменять владельца нельзя.
    match /greenhouses/{ghId} {
      allow read: if signedIn() && resource.data.ownerId == request.auth.uid;
      allow update: if signedIn()
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == resource.data.ownerId;

      // devices, history, events — всё внутри теплицы.
      match /{sub=**} {
        allow read, write: if ownsGreenhouse(ghId);
      }
    }

    // Оповещения лежат в общей коллекции, у каждого есть ownerId.
    match /alerts/{alertId} {
      allow read, update, delete: if signedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid;
    }
  }
}
